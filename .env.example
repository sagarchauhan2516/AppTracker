# ==============================================================================
# Vacancy Radar India - Environment Configuration Template
# ==============================================================================
# NOTE: Vacancy Radar India operates in 100% Zero-Cost mode by default using
# public government RSS feeds, open gazettes, and Google Apps Script serverless.
# None of the paid API keys below are required unless you explicitly choose to.
# ==============================================================================

# Local Static Server Port (Optional, default 3000 / auto-fallback)
PORT=3000

# Active Search Provider: FREE_PUBLIC_FEEDS | CUSTOM_SEARCH_API
ACTIVE_SEARCH_PROVIDER=FREE_PUBLIC_FEEDS

# Monthly Budget Safety Ceiling (INR - Set 0 for 100% Free Mode)
# System strictly enforces this hard limit and will stop before incurring charges.
MONTHLY_BUDGET_INR=0.00
MONTHLY_FREE_QUOTA_LIMIT=100

# Custom Search API Keys (Optional - only needed if CUSTOM_SEARCH_API is selected)
# Keep provider keys secure on your private server/environment.
CUSTOM_SEARCH_API_KEY=
CUSTOM_SEARCH_ENGINE_ID=

# Google Apps Script Web App Endpoint (For 24/7 cloud sync when PC is off)
# Obtain this by deploying google-apps-script/Code.gs as a Web App in Google Cloud.
GOOGLE_APPS_SCRIPT_WEBAPP_URL=
GOOGLE_SHEET_DATABASE_ID=

# Scheduled Alert Notifications (Asia/Kolkata IST)
NOTIFICATION_EMAIL=your-email@gmail.com
ALERT_SCHEDULE_HOURS_IST="08:00,14:00,20:00"

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gemini AI Integration (Optional)
GEMINI_API_KEY=

# Webhook Secret Token (Optional)
WEBHOOK_SECRET_TOKEN=

# CDAC Careers Decryption Key (Required for CDAC live vacancy discovery)
CDAC_CAREERS_KEY=

# CORS Allowed Origins (comma-separated, default: http://localhost:3000)
CORS_ALLOWED_ORIGINS=http://localhost:3000
